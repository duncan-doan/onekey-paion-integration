# Settings for the CLI scripts and local runs. Copy to .env and fill in.
# .env is gitignored - never commit real credentials.
# In Azure the same names are App Settings. A real environment variable always
# wins over .env. Commented lines show the default used when the line is absent.

# --- OneKey ---------------------------------------------------------------
# Environment: uat | prd | qa (or set ONEKEY_BASE_URL directly; it wins)
ONEKEY_ENV=uat
# ONEKEY_BASE_URL=https://okws-uat.onekey.iqvia.com

# Required
ONEKEY_USERNAME=494_PAION_API_UAT
ONEKEY_PASSWORD=
ONEKEY_CONNECTOR_ID=494

# Seconds per request
ONEKEY_TIMEOUT=30
# false/0/no turns certificate checks off
ONEKEY_VERIFY_SSL=true
# Rate-limit hygiene: attempts on connection errors, 429 and 5xx (default 8),
# and seconds between refreshMyOnekey packets (default 1.0)
ONEKEY_MAX_RETRIES=8
ONEKEY_PACKET_DELAY=1.5
# Records requested per refreshMyOnekey packet, 100-2000 (default 1000).
# OneKey cuts a larger request down to the connector's own cap (commonly 250,
# START HERE Guide 6.1.14), so asking for more costs nothing, while asking
# for less adds packets, packet delays and calls against the per-minute
# quota. Lower it only if packets start hitting ONEKEY_TIMEOUT.
ONEKEY_PAGE_SIZE=1000

# --- Dynamics 365 / Dataverse -------------------------------------------
# Required
DATAVERSE_URL=https://paion-crm-test.api.crm4.dynamics.com
DATAVERSE_TENANT_ID=30a31cfa-c6b9-4fc2-85e5-328f5d136372
DATAVERSE_CLIENT_ID=
DATAVERSE_CLIENT_SECRET=

DATAVERSE_API_VERSION=v9.2
# CreateMultiple/UpdateMultiple batch size (Microsoft: start at 100–1000; no hard max)
DATAVERSE_BULK_BATCH_SIZE=100
# Seconds per request
DATAVERSE_TIMEOUT=60

# --- Azure Function App ----------------------------------------------------
# Required by the queue output/trigger bindings. In Azure this is normally
# created automatically. The host reads work from "onekey-queue" and moves a
# message to "onekey-queue-poison" after five unsuccessful deliveries.
# AzureWebJobsStorage=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...
#
# Comma-separated codebases for the delta/full timers; sample_ok_to_dv uses the
# first. The CLI scripts take --codbase instead.
# ONEKEY_CODBASE=WUK
# HCOs upserted by sample_ok_to_dv (its ?hcos= query parameter overrides this)
# ONEKEY_SAMPLE=5
# The delta and full timers stay idle until this is true (true/1/yes).
# scripts/run_scheduled_sync.py runs regardless.
# SYNC_SCHEDULE=true
# Start every delta here instead of where the last job stopped reading (UTC,
# 2026-08-01 or 2026-08-01T00:00:00Z). Applies to every country and every
# night while set, so remove it once that window has been read.
# --date-from on the CLI still wins.
# SYNC_DELTA_FROM=2026-08-01
# Leave records that already hold the values to write unwritten (default true).
# The existence check reads the payload's columns and compares them; set false
# to write every record, as before.
# SYNC_SKIP_UNCHANGED=true

# --- Logging -----------------------------------------------------------------
# Sync log files and reports (sync_*.log, picklist_gaps_*.csv). Default logs/;
# "off" disables them. The Azure function app defaults to off (read-only app folder).
# SYNC_LOG_DIR=logs

# --- Tests -------------------------------------------------------------------
# Codebase for tests/test_live.py (requires pytest --live and credentials)
# ONEKEY_TEST_CODBASE=WDE
